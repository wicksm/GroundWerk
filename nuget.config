<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org, so a package can't come from a source a machine adds, and a restore needs no
       sign-in, GroundWerk.InnerSource's packages included (docs/adr/0014) -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
