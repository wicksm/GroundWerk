<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only these two sources, so a package can't come from a source a machine adds -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="innersource" value="https://pkgs.dev.azure.com/mikewicks-lab/GroundWerk/_packaging/innersource/nuget/v3/index.json" />
  </packageSources>
  <!-- GroundWerk.InnerSource's packages come only from its feed, and every other package only from
       nuget.org, so a package on nuget.org with a GroundWerk name is never restored
       (docs/adr/0009) -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="innersource">
      <package pattern="GroundWerk.*" />
    </packageSource>
  </packageSourceMapping>
  <!-- NuGet's audit reads vulnerability data only from nuget.org, so a restore reads the feed only
       for a GroundWerk.InnerSource package that isn't in the package cache (docs/adr/0009) -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
